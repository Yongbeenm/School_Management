# Application
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_USER=school
POSTGRES_PASSWORD=school_dev_password
POSTGRES_DB=school_management
DATABASE_URL=postgresql://school:school_dev_password@localhost:5432/school_management?schema=public

# Redis / queues
REDIS_URL=redis://localhost:6379

# Authentication — replace before deployment
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=14d
COOKIE_SECURE=false

# Development seed account — never use these defaults in production
SEED_ADMIN_EMAIL=admin@school.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Storage: local for development; set s3 for AWS S3 or Cloudflare R2
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Email: console prints reset links locally; set smtp for production
EMAIL_PROVIDER=console
EMAIL_FROM=School Management <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
